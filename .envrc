# Add the repo-local Unity Gateway CLI.
PATH_add .uvtools/bin

# Databricks setup:
# 1. Install the Databricks VS Code extension 2.17 or newer.
# 2. Authenticate and provide a clear profile name when prompted.
# 3. Select serverless or classic compute in the extension.
#
# The extension writes the selected profile and compute to this gitignored file.
source_env_if_exists .databricks/.databricks.env

# Run once after cloning or changing this file.
#   direnv allow
