# Add the repo-local Unity Gateway CLI.
PATH_add .uvtools/bin

# Databricks setup:
# 1. Install the Databricks VS Code extension 2.17 or newer.
# 2. Authenticate and provide a clear profile name when prompted.
# 3. Select serverless or classic compute in the extension.
#
# Remove stale connection selectors inherited from the parent shell.
unset DATABRICKS_AUTH_TYPE
unset DATABRICKS_CONFIG_PROFILE
unset DATABRICKS_HOST
unset DATABRICKS_METADATA_SERVICE_URL
unset DATABRICKS_TOKEN
unset DATABRICKS_CLIENT_ID
unset DATABRICKS_CLIENT_SECRET
unset DATABRICKS_CLUSTER_ID
unset DATABRICKS_SERVERLESS_COMPUTE_ID

# Export the extension-selected workspace, authentication, and compute.
dotenv_if_exists .databricks/.databricks.env

# Run once after cloning or changing this file.
#   direnv allow
